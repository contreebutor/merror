# ---------------------------------------------------------------------------
# MERROR — .gitignore
# Local-first app: nothing personal (memories, media, vector DB, keys) is ever
# committed. Only source code and documentation belong in this repo.
# ---------------------------------------------------------------------------

# --- Secrets & environment -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Node / Next.js --------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions
.next/
out/
build/
dist/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Package manager logs / debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# --- Python / FastAPI ------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.python-version
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
.eggs/
.installed.cfg
*.egg

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json
htmlcov/
.coverage
.coverage.*
.tox/
.nox/

# --- MERROR local data (never commit — this is the user's actual memory) ----
# Vector DB persistence
backend/data/
backend/chroma/
chroma_db/
*.sqlite3
*.duckdb

# Uploaded source files (documents + images) and generated audio
backend/uploads/
uploads/
media/
backend/audio_cache/

# Conversation history store
backend/conversations/

# Local model weights / caches (e.g. Whisper)
models/
.cache/

# --- OS --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Editors / IDEs --------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.claude/

# --- Logs ------------------------------------------------------------------
*.log
logs/
