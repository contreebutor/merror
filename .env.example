# MERROR — environment configuration
#
# Copy this file to `.env` and fill in your keys:
#     cp .env.example .env
#
# `.env` is gitignored and never leaves this machine. These keys are used only
# for direct calls to Anthropic and ElevenLabs.

# ---------------------------------------------------------------------------
# Secrets — BACKEND ONLY. These are never exposed to the browser.
# ---------------------------------------------------------------------------

# Anthropic API key — powers chat reasoning and image understanding.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ElevenLabs API key — powers text-to-speech in voice mode.
# Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Models & voice
# ---------------------------------------------------------------------------

# Claude model used for chat and image description.
ANTHROPIC_MODEL=claude-opus-5

# ElevenLabs voice ID. The default is "Rachel", a stock voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ElevenLabs model. eleven_multilingual_v2 is the quality default;
# eleven_turbo_v2_5 is faster and cheaper if latency matters more.
ELEVENLABS_MODEL=eleven_multilingual_v2

# Whisper size for speech-to-text, which runs locally: tiny | base | small |
# medium | large-v3. Larger is more accurate and slower; "base" is a good
# starting point and downloads about 150 MB on first use.
WHISPER_MODEL=base

# ---------------------------------------------------------------------------
# Local storage paths (relative to backend/, gitignored)
# ---------------------------------------------------------------------------

CHROMA_DIR=data/chroma
UPLOADS_DIR=data/uploads
WHISPER_CACHE_DIR=data/models

# ---------------------------------------------------------------------------
# Networking — safe to expose. NEXT_PUBLIC_* vars are readable in the browser,
# so never put a secret behind that prefix.
# ---------------------------------------------------------------------------

BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
